<Page x:Class="new_library_system.login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:new_library_system"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="login">

    <Grid Background="white">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="38*"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Height="410" Width="400" Grid.RowSpan="2">
            <TextBlock Text="login" FontSize="40" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center"/>
            <TextBlock Text="email" FontSize="25" HorizontalAlignment="Center" Margin="0,20"/>
            <TextBox Height="30" Width="300" Text="{Binding  Email, Mode=TwoWay}"/>
            <TextBlock Text="password" FontSize="25" HorizontalAlignment="Center" Margin="0,20"/>
            <PasswordBox Height="30" Width="300" Name="paswordpox"/>
            <Button Content="login" Height="69" Width="200" Margin="0,50" FontSize="40" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Page>
