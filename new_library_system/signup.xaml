<Page x:Class="new_library_system.signup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:new_library_system"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="signup">

    <Grid Background="#f0f0f0" Margin="0,0,0,-93">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350" Height="498" >

            <TextBlock Text="Sign Up" FontSize="30" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Username -->
            <TextBlock Text="Username" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameTextBox" Height="30" FontSize="14"/>

            <!-- Email -->
            <TextBlock Text="Email" FontSize="16" Margin="0,10,0,5"/>
            <TextBox x:Name="EmailTextBox" Height="30" FontSize="14"/>

            <!-- Password -->
            <TextBlock Text="Password" FontSize="16" Margin="0,10,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="30" FontSize="14"/>

            <!-- Confirm Password -->
            <TextBlock Text="Confirm Password" FontSize="16" Margin="0,10,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="30" FontSize="14"/>
            <RadioButton Content="member" Margin="0,10,0,5" GroupName="radio" Name="m_radio"/>
            <RadioButton Content="librarian" Margin="0,10,0,5" GroupName="radio" Name="l_radio"/>

            <Button Content="Sign Up" Height="40" 
                    Background="#4CAF50" Foreground="White" FontSize="16"
                    Click="SignUpButton_Click"/>
            <Button Content="have acc?" Margin="10,20,10,0" Height="30" Background="Blue" Foreground="#FFF2EBEB" FontSize="15" Click="Button_Click"/>
            <!-- Signup Button -->
        </StackPanel>
    </Grid>
</Page>