<Page x:Class="new_library_system.librian"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:new_library_system"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="librian">

    <Grid Background="white">
       
                <StackPanel Margin="20">
                    <TextBlock Text="Manage Library Books (Manual Mode)" FontSize="25" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="5">
                            <Label Content="Book Title:"/>
                            <TextBox x:Name="txtTitle" Height="30"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <Label Content="Author:"/>
                            <TextBox x:Name="txtAuthor" Height="30"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <Label Content="Category:"/>
                            <TextBox x:Name="txtCategory" Height="30"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <Label Content="Quantity:"/>
                            <TextBox x:Name="txtQuantity" Height="30"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                        <Button x:Name="btnAdd" Content="Add New" Click="AddBtn_Click" Width="100" Height="35" Margin="5" Background="Green" Foreground="White"/>
                        <Button x:Name="btnUpdate" Content="Update" Click="UpdateBtn_Click" Width="100" Height="35" Margin="5" Background="Blue" Foreground="White"/>
                        <Button x:Name="btnDelete" Content="Delete" Click="DeleteBtn_Click" Width="100" Height="35" Margin="5" Background="Red" Foreground="White"/>
                    </StackPanel>

                    <Label Content="All Books List:" FontWeight="Bold" Margin="0,10,0,0"/>

                    <DataGrid x:Name="dgBooks" 
                      AutoGenerateColumns="True" 
                      Height="115" 
                      IsReadOnly="True" 
                      Margin="0,5"
                      SelectionChanged="dgBooks_SelectionChanged"/>
                </StackPanel>
    </Grid>
</Page>
